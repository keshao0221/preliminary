+#include "cast_ninetoothed.hpp"
+#include "cast_layout.hpp"
+#include <infinicore/context/context.hpp>
+#include <infinicore/graph/graph.hpp>
+#include <cstdlib>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+
+#if defined(__linux__)
+#include <dlfcn.h>
+#endif
+
+namespace infinicore::op::cast_impl::ninetoothed {
+namespace {
+using Launch = int (*)(const char *, int, unsigned, void *, void **);
+using Error = const char *(*)();
+struct Runtime { void *handle; Launch launch; Error error; };
+
+Runtime &runtime(const std::string &root) {
+#if defined(__linux__)
+    static std::mutex mutex;
+    // Keep modules and the host library alive through asynchronous launches and
+    // recorded-operator replay. They are released by the OS at process exit.
+    static std::unordered_map<std::string, Runtime> cache;
+    std::lock_guard<std::mutex> lock(mutex);
+    auto found = cache.find(root);
+    if (found != cache.end()) return found->second;
+    auto handle = dlopen((root+"/libminimax_nine_cast_runtime.so").c_str(), RTLD_NOW | RTLD_LOCAL);
+    if (!handle) throw std::runtime_error(std::string("NineToothed Cast runtime load failed: ")+dlerror());
+    auto launch = reinterpret_cast<Launch>(dlsym(handle,"minimax_nine_cast_launch"));
+    auto error = reinterpret_cast<Error>(dlsym(handle,"minimax_nine_cast_error"));
+    if (!launch || !error) { dlclose(handle); throw std::runtime_error("NineToothed Cast runtime ABI mismatch"); }
+    return cache.emplace(root,Runtime{handle,launch,error}).first->second;
+#else
+    (void)root;
+    throw std::runtime_error("NineToothed Cast precompiled backend currently requires Linux");
+#endif
+}
+
+const char *dtype_name(DataType dtype) {
+    switch (dtype) {
+    case DataType::F32: return "f32";
+    case DataType::F16: return "f16";
+    case DataType::BF16: return "bf16";
+    default: throw std::invalid_argument("Enabled NineToothed Cast supports F32, F16 and BF16 only; no numerical fallback");
+    }
+}
+
+class CastOperator final : public graph::GraphOperator {
+    graph::GraphTensor output_, input_;
+    Layout layout_;
+    std::string root_, binary_;
+public:
+    CastOperator(Tensor output, const Tensor &input, std::string root)
+        : output_(output), input_(input),
+          layout_(normalize_layout(output->shape(),input->strides(),output->strides())), root_(std::move(root)) {
+        const std::string pair = std::string(dtype_name(input->dtype()))+"_to_"+dtype_name(output->dtype());
+        binary_ = root_+"/rank"+std::to_string(layout_.rank)+"/kernels/"+pair+"/kernel.hsaco";
+    }
+    // Retain graph-operator replay, and let Graph segment this host-managed
+    // launch outside device capture. No unsupported capture claim is made.
+    bool is_device_graph_capture_safe() const override { return false; }
+    void run() const override {
+        if (!layout_.elements) return;
+        auto output = output_, input = input_;
+        const auto device = output->device();
+        if (context::getDevice() != device) context::setDevice(device);
+        if (input->data() == output->data() && input->dtype() == output->dtype()
+            && input->strides() == output->strides()) return;
+        if (byte_ranges_overlap(reinterpret_cast<uintptr_t>(input->data()),layout_.input_span,input->element_size(),
+                reinterpret_cast<uintptr_t>(output->data()),layout_.output_span,output->element_size()))
+            throw std::invalid_argument("NineToothed Cast rejects aliased input/output spans");
+        LaunchArguments launch(layout_,input->data(),output->data());
+        auto &host = runtime(root_);
+        if (host.launch(binary_.c_str(),layout_.rank,layout_.grid,context::getStream(),launch.arguments.data()))
+            throw std::runtime_error(std::string("NineToothed Cast launch failed: ")+host.error());
+    }
+};
+} // namespace
+
+bool enabled() {
+    const char *root = std::getenv("INFINICORE_NINETOOTHED_CAST_ROOT");
+    return root && root[0];
+}
+
+void execute(Tensor output, const Tensor &input) {
+    const char *root = std::getenv("INFINICORE_NINETOOTHED_CAST_ROOT");
+    if (!root || !root[0]) throw std::runtime_error("NineToothed Cast root is not configured");
+    auto op = std::make_shared<CastOperator>(output,input,root);
+    if (context::isGraphRecording()) context::addGraphOperator(op);
+    else op->run();
+}
+} // namespace infinicore::op::cast_impl::ninetoothed
