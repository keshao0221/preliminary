+namespace infinicore::op::rms_norm_impl::ninetoothed {
+namespace {
+using Launch=int(*)(const char *,int,unsigned,unsigned,void *,void **);
+using Error=const char *(*)();
+struct Runtime { void *handle; Launch launch; Error error; };
+Runtime &runtime(const std::string &root) {
+#if defined(__linux__)
+    static std::mutex mutex; static std::unordered_map<std::string,Runtime> cache;
+    std::lock_guard<std::mutex> lock(mutex); auto found=cache.find(root); if(found!=cache.end()) return found->second;
+    auto handle=dlopen((root+"/libminimax_nine_rms_norm_runtime.so").c_str(),RTLD_NOW|RTLD_LOCAL);
+    if(!handle) throw std::runtime_error(std::string("RMSNorm host load failed: ")+dlerror());
+    auto launch=reinterpret_cast<Launch>(dlsym(handle,"minimax_nine_rms_norm_launch"));
+    auto error=reinterpret_cast<Error>(dlsym(handle,"minimax_nine_rms_norm_error"));
+    if(!launch || !error) { dlclose(handle); throw std::runtime_error("RMSNorm host ABI mismatch"); }
+    return cache.emplace(root,Runtime{handle,launch,error}).first->second;
+#else
+    (void)root; throw std::runtime_error("Precompiled NineToothed RMSNorm requires Linux");
+#endif
+}
+const char *dtype_name(DataType type) {
+    switch(type) { case DataType::F32:return "f32"; case DataType::F16:return "f16"; case DataType::BF16:return "bf16";
+    default:throw std::invalid_argument("RMSNorm supports F32/F16/BF16; no numerical fallback"); }
+}
+class Operator final:public graph::GraphOperator {
+    graph::GraphTensor output_,input_,weight_;
+    Layout layout_;
+    float epsilon_;
+    std::string root_,binary_;
+public:
+    Operator(Tensor output,const Tensor &input,const Tensor &weight,float epsilon,std::string root)
+        :output_(output),input_(input),weight_(weight),layout_(normalize_layout(input->shape(),input->strides(),output->strides(),weight->numel(),weight->strides().back())),epsilon_(epsilon),root_(std::move(root)) {
+        const std::string data=dtype_name(input->dtype()),wtype=dtype_name(weight->dtype());
+        if(input->dtype()!=output->dtype() || (input->dtype()==DataType::F32 && weight->dtype()!=DataType::F32))
+            throw std::invalid_argument("RMSNorm input/output dtype and weight pairing unsupported");
+        if(!std::isfinite(epsilon) || epsilon<0) throw std::invalid_argument("RMSNorm epsilon must be finite and nonnegative");
+        binary_=root_+"/tile"+std::to_string(layout_.tile)+"/kernels/"+data+"_"+wtype+"/kernel.hsaco";
+    }
+    bool is_device_graph_capture_safe() const override { return false; }
+    void run() const override {
+        if(!layout_.rows) return;
+        auto output=output_,input=input_,weight=weight_;
+        const bool same=input->data()==output->data() && input->strides()==output->strides();
+        if(!same && byte_ranges_overlap(reinterpret_cast<uintptr_t>(input->data()),layout_.input_span,input->element_size(),reinterpret_cast<uintptr_t>(output->data()),layout_.output_span,output->element_size()))
+            throw std::invalid_argument("RMSNorm partially aliased input/output");
+        if(byte_ranges_overlap(reinterpret_cast<uintptr_t>(weight->data()),layout_.shape[2],weight->element_size(),reinterpret_cast<uintptr_t>(output->data()),layout_.output_span,output->element_size()))
+            throw std::invalid_argument("RMSNorm output aliases shared weight");
+        if(context::getDevice()!=output->device()) context::setDevice(output->device());
+        LaunchArguments args(layout_,input->data(),weight->data(),output->data(),epsilon_); auto &host=runtime(root_);
+        if(host.launch(binary_.c_str(),layout_.tile,layout_.rows,layout_.shape[2],context::getStream(),args.arguments.data()))
+            throw std::runtime_error(std::string("NineToothed RMSNorm launch failed: ")+host.error());
+    }
+};
+}
+bool enabled() { auto root=std::getenv("INFINICORE_NINETOOTHED_RMS_NORM_ROOT"); return root && root[0]; }
+void execute(Tensor output,const Tensor &input,const Tensor &weight,float epsilon) {
+    auto root=std::getenv("INFINICORE_NINETOOTHED_RMS_NORM_ROOT"); if(!root || !root[0]) throw std::runtime_error("RMSNorm root missing");
+    auto op=std::make_shared<Operator>(output,input,weight,epsilon,root);
+    if(context::isGraphRecording()) context::addGraphOperator(op); else op->run();
+}
