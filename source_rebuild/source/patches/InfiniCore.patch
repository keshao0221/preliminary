+}
+const char *dtype_name(DataType type) {
+    switch(type) {
+    case DataType::I32:return "i32"; case DataType::I64:return "i64";
+    case DataType::F16:return "f16"; case DataType::BF16:return "bf16";
+    case DataType::F32:return "f32"; case DataType::F64:return "f64";
+    default:throw std::invalid_argument("Unsupported NineToothed rotary dtype; no numerical fallback");
+    }
+}
+class RotaryOperator final : public graph::GraphOperator {
+    graph::GraphTensor output_,positions_;
+    Layout layout_;
+    float theta_;
+    std::string root_,binary_;
+public:
+    RotaryOperator(Tensor output,const Tensor &positions,float theta,std::string root)
+        : output_(output),positions_(positions),
+          layout_(prepare_layout(positions->size(0),output->size(1)/6,positions->stride(0),positions->stride(1),theta)),theta_(theta),root_(std::move(root)) {
+        binary_=root_+"/kernels/"+dtype_name(positions->dtype())+"_to_"+dtype_name(output->dtype())+"/kernel.hsaco";
+    }
+    bool is_device_graph_capture_safe() const override { return false; }
+    void run() const override {
+        if (!layout_.rows) return;
+        auto output=output_,positions=positions_;
+        if (context::getDevice()!=output->device()) context::setDevice(output->device());
+        if (byte_ranges_overlap(reinterpret_cast<uintptr_t>(positions->data()),layout_.input_span,positions->element_size(),
+                reinterpret_cast<uintptr_t>(output->data()),layout_.output_span,output->element_size()))
+            throw std::invalid_argument("NineToothed rotary rejects aliased position/output spans");
+        LaunchArguments arguments(layout_,positions->data(),output->data(),output->element_size(),theta_);
+        auto &host=runtime(root_);
+        if (host.launch(binary_.c_str(),layout_.grid,context::getStream(),arguments.arguments.data()))
+            throw std::runtime_error(std::string("NineToothed rotary launch failed: ")+host.error());
+    }
+};
+}
+bool enabled() {
+    const auto root=std::getenv("INFINICORE_NINETOOTHED_H3_ROTARY_ROOT"); return root && root[0];
+}
+void execute(Tensor output,const Tensor &positions,float theta) {
+    const auto root=std::getenv("INFINICORE_NINETOOTHED_H3_ROTARY_ROOT");
+    if (!root || !root[0]) throw std::runtime_error("NineToothed rotary root missing");
+    auto op=std::make_shared<RotaryOperator>(output,positions,theta,root);
+    if (context::isGraphRecording()) context::addGraphOperator(op); else op->run();
+}
