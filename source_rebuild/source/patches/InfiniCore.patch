+inline uint64_t add(uint64_t a,uint64_t b) {
+    if(b>uint64_t(INT64_MAX) || a>uint64_t(INT64_MAX)-b) throw std::invalid_argument("MRoPE metadata exceeds int64");
+    return a+b;
