+#if defined(__linux__)
+#include <dlfcn.h>
+#endif
+namespace infinicore::op::swiglu_impl::ninetoothed {
+namespace {
+using Launch=int(*)(const char *,int,unsigned,void *,void **);
+using Error=const char *(*)();
+struct Runtime { void *handle; Launch launch; Error error; };
+Runtime &runtime(const std::string &root) {
+#if defined(__linux__)
+    static std::mutex mutex; static std::unordered_map<std::string,Runtime> cache;
+    std::lock_guard<std::mutex> lock(mutex);
+    auto found=cache.find(root); if(found!=cache.end()) return found->second;
+    auto handle=dlopen((root+"/libminimax_nine_swiglu_runtime.so").c_str(),RTLD_NOW|RTLD_LOCAL);
+    if(!handle) throw std::runtime_error(std::string("NineToothed SwiGLU host load failed: ")+dlerror());
+    auto launch=reinterpret_cast<Launch>(dlsym(handle,"minimax_nine_swiglu_launch"));
+    auto error=reinterpret_cast<Error>(dlsym(handle,"minimax_nine_swiglu_error"));
+    if(!launch || !error) { dlclose(handle); throw std::runtime_error("NineToothed SwiGLU host ABI mismatch"); }
+    return cache.emplace(root,Runtime{handle,launch,error}).first->second;
+#else
+    (void)root; throw std::runtime_error("Precompiled NineToothed SwiGLU requires Linux");
+#endif
+}
+const char *dtype_name(DataType type) {
+    switch(type) {
+    case DataType::F32:return "f32"; case DataType::F16:return "f16"; case DataType::BF16:return "bf16";
+    default:throw std::invalid_argument("NineToothed SwiGLU supports F32/F16/BF16; no numerical fallback");
+    }
+}
+class SwiGLUOperator final:public graph::GraphOperator {
+    graph::GraphTensor output_,up_,gate_;
+    Layout layout_;
+    std::string root_,binary_;
+public:
+    SwiGLUOperator(Tensor output,const Tensor &up,const Tensor &gate,std::string root)
+        :output_(output),up_(up),gate_(gate),layout_(normalize_layout(up->shape(),up->strides(),gate->strides(),output->strides())),root_(std::move(root)) {
+        const std::string name=dtype_name(up->dtype());
+        if(output->dtype()!=up->dtype() || gate->dtype()!=up->dtype()) throw std::invalid_argument("SwiGLU dtypes must match");
+        binary_=root_+"/rank"+std::to_string(layout_.rank)+"/kernels/"+name+"/kernel.hsaco";
+    }
+    bool is_device_graph_capture_safe() const override { return false; }
+    void run() const override {
+        if(!layout_.elements) return;
+        auto output=output_,up=up_,gate=gate_;
+        for(const auto &input:{up,gate}) {
+            const bool same_view=input->data()==output->data() && input->strides()==output->strides();
+            const auto span=input==up?layout_.up_span:layout_.gate_span;
+            if(!same_view && byte_ranges_overlap(reinterpret_cast<uintptr_t>(input->data()),span,input->element_size(),
+                    reinterpret_cast<uintptr_t>(output->data()),layout_.output_span,output->element_size()))
+                throw std::invalid_argument("SwiGLU rejects partially aliased input/output spans");
+        }
+        if(context::getDevice()!=output->device()) context::setDevice(output->device());
+        LaunchArguments arguments(layout_,up->data(),gate->data(),output->data());
+        auto &host=runtime(root_);
+        if(host.launch(binary_.c_str(),layout_.rank,layout_.grid,context::getStream(),arguments.arguments.data()))
+            throw std::runtime_error(std::string("NineToothed SwiGLU launch failed: ")+host.error());
+    }
+};
+}
+bool enabled() { const auto root=std::getenv("INFINICORE_NINETOOTHED_SWIGLU_ROOT"); return root && root[0]; }
+void execute(Tensor output,const Tensor &up,const Tensor &gate) {
+    const auto root=std::getenv("INFINICORE_NINETOOTHED_SWIGLU_ROOT");
+    if(!root || !root[0]) throw std::runtime_error("NineToothed SwiGLU root missing");
+    auto op=std::make_shared<SwiGLUOperator>(output,up,gate,root);
+    if(context::isGraphRecording()) context::addGraphOperator(op); else op->run();
+}
