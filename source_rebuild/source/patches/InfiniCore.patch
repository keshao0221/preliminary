+#pragma once
+// Host metadata normalization only; all device conversion is NineToothed code.
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+#include <utility>
+#include <vector>
+
+namespace infinicore::op::cast_impl::ninetoothed {
+struct Layout {
+    std::array<int64_t, 8> shape{}, input_strides{}, output_strides{};
+    uint64_t elements = 0, input_span = 0, output_span = 0;
+    uint32_t grid = 0;
+    int rank = 1;
+};
+
+inline uint64_t checked_add(uint64_t a, uint64_t b) {
+    if (b > uint64_t(INT64_MAX) || a > uint64_t(INT64_MAX) - b) throw std::invalid_argument("NineToothed Cast metadata exceeds int64");
+    return a + b;
+}
+inline uint64_t checked_mul(uint64_t a, uint64_t b) {
+    if (b && a > uint64_t(INT64_MAX) / b) throw std::invalid_argument("NineToothed Cast metadata exceeds int64");
+    return a * b;
+}
+
+inline Layout normalize_layout(const std::vector<size_t> &shape,
+    const std::vector<ptrdiff_t> &input_strides, const std::vector<ptrdiff_t> &output_strides) {
+    if (shape.size() > 8 || shape.size() != input_strides.size() || shape.size() != output_strides.size())
+        throw std::invalid_argument("NineToothed Cast supports matching metadata of rank 0 through 8");
+    Layout result;
+    result.shape.fill(1); result.input_strides.fill(0); result.output_strides.fill(0);
+    bool empty = false;
+    for (size_t i = 0; i < shape.size(); ++i) {
+        if (shape[i] > uint64_t(INT64_MAX) || input_strides[i] < 0 || output_strides[i] < 0)
+            throw std::invalid_argument("NineToothed Cast requires nonnegative int64 sizes and strides");
+        empty = empty || shape[i] == 0;
+    }
+    if (empty) { result.shape[7] = 0; return result; }
+    result.elements = 1;
+    uint64_t input_last = 0, output_last = 0;
+    std::vector<std::pair<uint64_t, uint64_t>> output_axes;
+    std::vector<int64_t> sizes, in, out;
+    for (size_t i = 0; i < shape.size(); ++i) {
+        result.elements = checked_mul(result.elements, shape[i]);
+        input_last = checked_add(input_last, checked_mul(shape[i] - 1, input_strides[i]));
+        output_last = checked_add(output_last, checked_mul(shape[i] - 1, output_strides[i]));
+        if (shape[i] > 1) {
+            sizes.push_back(static_cast<int64_t>(shape[i]));
+            in.push_back(input_strides[i]); out.push_back(output_strides[i]);
+            output_axes.emplace_back(output_strides[i], shape[i]);
+        }
+    }
+    // A sufficient non-overlap check allows transposes, permutations and holes.
+    // Ambiguous overlapping output views are rejected before any GPU launch.
+    std::sort(output_axes.begin(), output_axes.end());
+    uint64_t covered = 1;
+    for (const auto &axis : output_axes) {
+        if (axis.first < covered) throw std::invalid_argument("NineToothed Cast output view may overlap");
+        covered = checked_add(covered, checked_mul(axis.second - 1, axis.first));
+    }
+    result.input_span = checked_add(input_last, 1);
+    result.output_span = checked_add(output_last, 1);
+    for (size_t i = sizes.size(); i > 1; --i) {
+        const size_t j = i - 2;
+        if (uint64_t(in[j]) == checked_mul(in[j+1], sizes[j+1]) &&
+            uint64_t(out[j]) == checked_mul(out[j+1], sizes[j+1])) {
+            sizes[j] = static_cast<int64_t>(checked_mul(sizes[j], sizes[j+1]));
+            in[j] = in[j+1]; out[j] = out[j+1];
+            sizes.erase(sizes.begin()+j+1); in.erase(in.begin()+j+1); out.erase(out.begin()+j+1);
+        }
+    }
+    if (sizes.empty()) { sizes.push_back(1); in.push_back(1); out.push_back(1); }
+    const size_t start = 8 - sizes.size();
+    for (size_t i = 0; i < sizes.size(); ++i) {
+        result.shape[start+i] = sizes[i];
+        result.input_strides[start+i] = in[i]; result.output_strides[start+i] = out[i];
+    }
+    result.rank = sizes.size() == 1 ? 1 : 8;
+    uint64_t grid = 1 + (uint64_t(result.shape[7]) - 1) / 256;
+    for (size_t i = 0; i < 7; ++i) grid = checked_mul(grid, result.shape[i]);
+    if (grid > INT32_MAX) throw std::invalid_argument("NineToothed Cast grid exceeds supported x dimension");
+    result.grid = static_cast<uint32_t>(grid);
+    return result;
+}
+
+inline bool byte_ranges_overlap(uintptr_t input, uint64_t input_span, size_t input_bytes,
+    uintptr_t output, uint64_t output_span, size_t output_bytes) {
+    const uint64_t a = checked_mul(input_span, input_bytes), b = checked_mul(output_span, output_bytes);
+    if (a > UINTPTR_MAX - input || b > UINTPTR_MAX - output)
+        throw std::invalid_argument("NineToothed Cast address range overflow");
+    return input < output + b && output < input + a;
+}
+
+struct LaunchArguments {
+    std::array<void *,2> data;
+    std::array<int64_t,32> scalars{};
+    std::array<void *,36> arguments{};
+    void *global_scratch = nullptr, *profile_scratch = nullptr;
+    LaunchArguments(const Layout &layout, void *input, void *output) : data{input,output} {
+        const int rank = layout.rank;
+        for (int tensor = 0; tensor < 2; ++tensor) {
+            const int base = tensor*(1+2*rank);
+            arguments[base] = &data[tensor];
+            for (int dim = 0; dim < rank; ++dim) {
+                const int index = 8-rank+dim;
+                scalars[tensor*2*rank+dim] = layout.shape[index];
+                scalars[tensor*2*rank+rank+dim] = tensor ? layout.output_strides[index] : layout.input_strides[index];
+                arguments[base+1+dim] = &scalars[tensor*2*rank+dim];
+                arguments[base+1+rank+dim] = &scalars[tensor*2*rank+rank+dim];
+            }
+        }
+        arguments[2+4*rank] = &global_scratch;
+        arguments[3+4*rank] = &profile_scratch;
+    }
+    LaunchArguments(const LaunchArguments &) = delete;
+    LaunchArguments &operator=(const LaunchArguments &) = delete;
+};
+} // namespace infinicore::op::cast_impl::ninetoothed
