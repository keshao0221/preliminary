+    default:throw std::invalid_argument("NineToothed MRoPE supports F16/BF16/F32; no numerical fallback");
+    }
+}
+class MRoPEOperator final : public graph::GraphOperator {
+    std::array<graph::GraphTensor,7> tensors_;
+    Layout layout_;
+    std::string root_,binary_;
+public:
+    MRoPEOperator(Tensor qo,Tensor ko,const Tensor &q,const Tensor &k,const Tensor &cos,const Tensor &sin,const Tensor &pos,
+                 const std::array<int64_t,6> &params,std::string root)
+        : tensors_{graph::GraphTensor(qo),graph::GraphTensor(ko),graph::GraphTensor(q),graph::GraphTensor(k),graph::GraphTensor(cos),graph::GraphTensor(sin),graph::GraphTensor(pos)},root_(std::move(root)) {
+        const std::array<Tensor,7> all{qo,ko,q,k,cos,sin,pos}; std::array<Meta,7> metadata;
+        const std::string name=data_name(q->dtype());
+        for(size_t i=0;i<7;++i) {
+            if(all[i]->device()!=q->device()) throw std::invalid_argument("MRoPE requires the same device");
+            if(i<6 && all[i]->dtype()!=q->dtype()) throw std::invalid_argument("MRoPE data dtypes differ");
+            for(auto d:all[i]->shape()) {
+                if(d>uint64_t(INT64_MAX)) throw std::invalid_argument("MRoPE size exceeds int64");
+                metadata[i].shape.push_back(static_cast<int64_t>(d));
+            }
+            for(auto s:all[i]->strides()) metadata[i].strides.push_back(s);
+        }
+        if(pos->dtype()!=DataType::I32 && pos->dtype()!=DataType::I64) throw std::invalid_argument("MRoPE positions must be I32/I64");
+        layout_=prepare_layout(metadata,params);
