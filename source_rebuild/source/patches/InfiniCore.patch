+    }
+    bool is_device_graph_capture_safe() const override { return false; }
+    void run() const override {
+        if(!layout_.grids[0] && !layout_.grids[1]) return;
+        std::array<void *,7> pointers;
+        for(size_t i=0;i<7;++i) { auto tensor=tensors_[i]; pointers[i]=tensor->data(); }
+        validate_alias(layout_,pointers,tensors_[0]->element_size(),tensors_[6]->element_size());
+        const auto device=tensors_[0]->device();
+        if(context::getDevice()!=device) context::setDevice(device);
+        auto &host=runtime(root_);
+        for(int which=0;which<2;++which) {
+            LaunchArguments args(layout_,pointers,which);
+            if(host.launch(binary_.c_str(),layout_.grids[which],context::getStream(),args.arguments.data()))
+                throw std::runtime_error(std::string("NineToothed MRoPE launch failed: ")+host.error());
+        }
+    }
+};
+}
+bool enabled() { const auto root=std::getenv("INFINICORE_NINETOOTHED_MROPE_ROOT"); return root && root[0]; }
+void execute(Tensor qo,Tensor ko,const Tensor &q,const Tensor &k,const Tensor &cos,const Tensor &sin,const Tensor &pos,
+             int head,int rotary,int t,int h,int w,bool interleaved) {
+    const auto root=std::getenv("INFINICORE_NINETOOTHED_MROPE_ROOT");
