+#pragma once
+// Metadata only; the reduction and output arithmetic are NineToothed code.
+#include "../../cast/ninetoothed/cast_layout.hpp"
+#include <cmath>
+namespace infinicore::op::rms_norm_impl::ninetoothed {
+using cast_impl::ninetoothed::checked_add;
+using cast_impl::ninetoothed::checked_mul;
+using cast_impl::ninetoothed::byte_ranges_overlap;
+struct Layout {
+    std::array<int64_t,3> shape{1,1,1},input{},output{};
+    uint64_t rows=0,elements=0,input_span=0,output_span=0;
+    int tile=128;
+    unsigned shared=8;
+};
+inline Layout normalize_layout(const std::vector<size_t> &shape,const std::vector<ptrdiff_t> &input,const std::vector<ptrdiff_t> &output,size_t weights,ptrdiff_t weight_stride) {
+    if((shape.size()!=2 && shape.size()!=3) || shape.size()!=input.size() || shape.size()!=output.size())
+        throw std::invalid_argument("NineToothed RMSNorm requires rank 2 or 3");
+    const size_t width=shape.back();
+    if(!width || width>8192 || weights!=width || weight_stride!=1 || input.back()!=1 || output.back()!=1)
+        throw std::invalid_argument("RMSNorm requires width 1..8192, matching contiguous weight and last dimension");
+    for(size_t i=0;i<shape.size();++i)
+        if(shape[i]>uint64_t(INT64_MAX) || input[i]<0 || output[i]<0) throw std::invalid_argument("RMSNorm requires nonnegative int64 metadata");
+    Layout result; result.tile=width<=128?128:width<=1024?1024:8192; result.shared=result.tile==128?8:16;
+    if(shape.size()==2) { result.shape={int64_t(shape[0]),1,int64_t(width)}; result.input={input[0],0,1}; result.output={output[0],0,1}; }
+    else for(size_t i=0;i<3;++i) { result.shape[i]=shape[i]; result.input[i]=input[i]; result.output[i]=output[i]; }
+    result.rows=checked_mul(result.shape[0],result.shape[1]); result.elements=checked_mul(result.rows,width);
+    if(result.rows>INT32_MAX) throw std::invalid_argument("RMSNorm grid exceeds supported x dimension");
+    if(!result.rows) return result;
+    uint64_t il=0,ol=0; std::vector<std::pair<uint64_t,uint64_t>> axes;
+    for(size_t i=0;i<3;++i) {
+        il=checked_add(il,checked_mul(result.shape[i]-1,result.input[i]));
+        ol=checked_add(ol,checked_mul(result.shape[i]-1,result.output[i]));
+        if(result.shape[i]>1) axes.emplace_back(result.output[i],result.shape[i]);
+    }
+    std::sort(axes.begin(),axes.end()); uint64_t covered=1;
+    for(const auto &axis:axes) {
+        if(axis.first<covered) throw std::invalid_argument("RMSNorm output may overlap");
+        covered=checked_add(covered,checked_mul(axis.second-1,axis.first));
+    }
+    result.input_span=checked_add(il,1); result.output_span=checked_add(ol,1); return result;
+}
+struct LaunchArguments {
+    float epsilon;
+    std::array<void *,3> data;
+    std::array<int64_t,19> scalars{};
+    std::array<void *,25> arguments{};
+    void *global_scratch=nullptr,*profile_scratch=nullptr;
+    LaunchArguments(const Layout &layout,void *input,void *weight,void *output,float eps):epsilon(eps),data{input,weight,output} {
+        scalars[0]=layout.shape[2]; arguments[0]=&epsilon; arguments[1]=&scalars[0];
+        for(int tensor=0;tensor<3;++tensor) {
+            const int base=2+7*tensor; arguments[base]=&data[tensor];
+            for(int d=0;d<3;++d) {
+                scalars[1+6*tensor+d]=layout.shape[d];
+                scalars[1+6*tensor+3+d]=tensor==0?layout.input[d]:tensor==2?layout.output[d]:d==2?1:0;
+                arguments[base+1+d]=&scalars[1+6*tensor+d]; arguments[base+4+d]=&scalars[1+6*tensor+3+d];
+            }
+        }
+        arguments[23]=&global_scratch; arguments[24]=&profile_scratch;
+    }
+    LaunchArguments(const LaunchArguments &)=delete;
+    LaunchArguments &operator=(const LaunchArguments &)=delete;
+};
+}
