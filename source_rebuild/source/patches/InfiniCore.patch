+    std::lock_guard<std::mutex> lock(mutex);
+    const auto found=cache.find(root); if (found!=cache.end()) return found->second;
+    auto handle=dlopen((root+"/libminimax_nine_rotary_runtime.so").c_str(),RTLD_NOW|RTLD_LOCAL);
+    if (!handle) throw std::runtime_error(std::string("NineToothed rotary host load failed: ")+dlerror());
+    auto launch=reinterpret_cast<Launch>(dlsym(handle,"minimax_nine_rotary_launch"));
+    auto error=reinterpret_cast<Error>(dlsym(handle,"minimax_nine_rotary_error"));
+    if (!launch || !error) { dlclose(handle); throw std::runtime_error("NineToothed rotary host ABI mismatch"); }
+    return cache.emplace(root,Runtime{handle,launch,error}).first->second;
