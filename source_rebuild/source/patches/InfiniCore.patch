+#pragma once
+// Host layout/ABI only. Device frequencies and trigonometry are NineToothed.
+#include "../../cast/ninetoothed/cast_layout.hpp"
+#include <cmath>
+
+namespace infinicore::op::h3_rotary_cache_impl::ninetoothed {
+using cast_impl::ninetoothed::checked_add;
+using cast_impl::ninetoothed::checked_mul;
+using cast_impl::ninetoothed::byte_ranges_overlap;
+struct Layout {
+    int64_t rows, dim, stride0, stride1;
+    uint64_t input_span, output_span;
+    unsigned grid;
+};
+inline Layout prepare_layout(uint64_t rows,uint64_t dim,int64_t stride0,int64_t stride1,float theta) {
+    if (rows>INT64_MAX || !dim || dim>uint64_t(INT64_MAX)/6 || stride0<0 || stride1<0 || !(theta>0) || !std::isfinite(theta))
+        throw std::invalid_argument("NineToothed H3 rotary requires nonnegative int64 layout, positive frequency dimension and finite positive theta");
+    const auto width=checked_mul(6,dim);
+    const auto output=checked_mul(rows,width);
+    const auto input=rows ? checked_add(1,checked_add(checked_mul(rows-1,stride0),checked_mul(2,stride1))) : 0;
+    const auto grid=rows ? checked_mul(checked_mul(1+(rows-1)/16,3),1+(dim-1)/16) : 0;
+    if (grid>INT32_MAX) throw std::invalid_argument("NineToothed H3 rotary grid exceeds signed 31-bit x dimension");
+    return {static_cast<int64_t>(rows),static_cast<int64_t>(dim),stride0,stride1,input,output,static_cast<unsigned>(grid)};
+}
+struct LaunchArguments {
+    std::array<void *,3> data;
+    std::array<int64_t,18> scalars{};
+    std::array<float,2> config;
+    void *scratch=nullptr,*profile=nullptr;
+    std::array<void *,25> arguments{};
+    LaunchArguments(const Layout &layout,void *positions,void *output,size_t output_bytes,float theta)
