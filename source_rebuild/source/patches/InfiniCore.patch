+    auto op=std::make_shared<MRoPEOperator>(qo,ko,q,k,cos,sin,pos,std::array<int64_t,6>{head,rotary,t,h,w,interleaved},root);
+    if(context::isGraphRecording()) context::addGraphOperator(op); else op->run();
+}
