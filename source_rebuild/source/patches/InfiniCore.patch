+#pragma once
+// Host metadata only. Numerical operations are in the NineToothed definition.
+#include "../../cast/ninetoothed/cast_layout.hpp"
+
+namespace infinicore::op::swiglu_impl::ninetoothed {
+using cast_impl::ninetoothed::checked_add;
+using cast_impl::ninetoothed::checked_mul;
+using cast_impl::ninetoothed::byte_ranges_overlap;
+
+struct Layout {
+    std::array<int64_t,8> shape{},up_strides{},gate_strides{},output_strides{};
+    uint64_t elements=0,up_span=0,gate_span=0,output_span=0;
+    uint32_t grid=0;
+    int rank=1;
+};
+
+inline Layout normalize_layout(const std::vector<size_t> &shape,
+    const std::vector<ptrdiff_t> &up,const std::vector<ptrdiff_t> &gate,
+    const std::vector<ptrdiff_t> &output) {
+    if(shape.size()>8 || shape.size()!=up.size() || shape.size()!=gate.size() || shape.size()!=output.size())
+        throw std::invalid_argument("NineToothed SwiGLU requires matching rank 0 through 8 metadata");
+    Layout result; result.shape.fill(1);
+    bool empty=false;
+    for(size_t i=0;i<shape.size();++i) {
+        if(shape[i]>uint64_t(INT64_MAX) || up[i]<0 || gate[i]<0 || output[i]<0)
+            throw std::invalid_argument("NineToothed SwiGLU requires nonnegative int64 metadata");
+        empty=empty || shape[i]==0;
+    }
+    if(empty) { result.shape[7]=0; return result; }
+    result.elements=1;
+    uint64_t ul=0,gl=0,ol=0;
+    std::vector<int64_t> sizes,us,gs,os;
+    std::vector<std::pair<uint64_t,uint64_t>> output_axes;
+    for(size_t i=0;i<shape.size();++i) {
+        result.elements=checked_mul(result.elements,shape[i]);
+        ul=checked_add(ul,checked_mul(shape[i]-1,up[i]));
+        gl=checked_add(gl,checked_mul(shape[i]-1,gate[i]));
+        ol=checked_add(ol,checked_mul(shape[i]-1,output[i]));
+        if(shape[i]>1) {
+            sizes.push_back(shape[i]); us.push_back(up[i]); gs.push_back(gate[i]); os.push_back(output[i]);
+            output_axes.emplace_back(output[i],shape[i]);
+        }
+    }
+    std::sort(output_axes.begin(),output_axes.end());
+    uint64_t covered=1;
+    for(const auto &axis:output_axes) {
+        if(axis.first<covered) throw std::invalid_argument("NineToothed SwiGLU output view may overlap");
+        covered=checked_add(covered,checked_mul(axis.second-1,axis.first));
+    }
+    result.up_span=checked_add(ul,1); result.gate_span=checked_add(gl,1); result.output_span=checked_add(ol,1);
+    // Collapse an axis only when all three tensors share the same linear order.
+    for(size_t i=sizes.size();i>1;--i) {
+        const size_t j=i-2;
+        if(uint64_t(us[j])==checked_mul(us[j+1],sizes[j+1]) &&
+           uint64_t(gs[j])==checked_mul(gs[j+1],sizes[j+1]) &&
+           uint64_t(os[j])==checked_mul(os[j+1],sizes[j+1])) {
+            sizes[j]=checked_mul(sizes[j],sizes[j+1]); us[j]=us[j+1]; gs[j]=gs[j+1]; os[j]=os[j+1];
+            sizes.erase(sizes.begin()+j+1); us.erase(us.begin()+j+1); gs.erase(gs.begin()+j+1); os.erase(os.begin()+j+1);
+        }
+    }
+    if(sizes.empty()) { sizes.push_back(1); us.push_back(1); gs.push_back(1); os.push_back(1); }
+    const size_t start=8-sizes.size();
+    for(size_t i=0;i<sizes.size();++i) {
+        result.shape[start+i]=sizes[i]; result.up_strides[start+i]=us[i]; result.gate_strides[start+i]=gs[i]; result.output_strides[start+i]=os[i];
+    }
+    // The standard rank-1 generator computes pid*tile in i32. Route larger
+    // linear extents through rank 8, whose runtime size divisions promote the
+    // index before multiplication. Strides remain i64 in both variants.
+    result.rank=sizes.size()==1 && sizes[0]<=INT32_MAX?1:8;
+    uint64_t grid=1+(uint64_t(result.shape[7])-1)/256;
+    for(size_t i=0;i<7;++i) grid=checked_mul(grid,result.shape[i]);
+    if(grid>INT32_MAX) throw std::invalid_argument("NineToothed SwiGLU grid exceeds supported x dimension");
+    result.grid=grid;
+    return result;
+}
+
+struct LaunchArguments {
+    std::array<void *,3> data;
+    std::array<int64_t,48> scalars{};
+    std::array<void *,53> arguments{};
+    void *global_scratch=nullptr,*profile_scratch=nullptr;
+    LaunchArguments(const Layout &layout,void *up,void *gate,void *output):data{up,gate,output} {
+        const int rank=layout.rank;
+        const std::array<std::array<int64_t,8>,3> strides{layout.up_strides,layout.gate_strides,layout.output_strides};
+        for(int tensor=0;tensor<3;++tensor) {
+            const int base=tensor*(1+2*rank); arguments[base]=&data[tensor];
+            for(int dim=0;dim<rank;++dim) {
+                const int index=8-rank+dim;
+                scalars[tensor*2*rank+dim]=layout.shape[index];
+                scalars[tensor*2*rank+rank+dim]=strides[tensor][index];
+                arguments[base+1+dim]=&scalars[tensor*2*rank+dim];
+                arguments[base+1+rank+dim]=&scalars[tensor*2*rank+rank+dim];
+            }
+        }
+        arguments[3+6*rank]=&global_scratch; arguments[4+6*rank]=&profile_scratch;
+    }
+    LaunchArguments(const LaunchArguments &)=delete;
+    LaunchArguments &operator=(const LaunchArguments &)=delete;
+};
+}
